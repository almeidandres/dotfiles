#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "usage: omp-cloud" >&2
    exit 2
fi

OMP_CLOUD_SSH_HOST="${OMP_CLOUD_SSH_HOST:-panda}"

command -v ssh >/dev/null || { echo "omp-cloud: ssh is not installed" >&2; exit 127; }

exec ssh -tt -- "$OMP_CLOUD_SSH_HOST" \
    "docker exec -it --user 1000:1000 --workdir /workspaces/omp/projects/services assistant-omp omp --no-title"
